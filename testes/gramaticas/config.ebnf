(* Arquivos de configuracao com secoes e tuplas *)
TOKENS
    ID = /[a-zA-Z_][a-zA-Z0-9_]*/;
    NUM = /[0-9]+/;
    SKIP = /[ \t\r\n]+/;

RULES
    config = { secao } ;
    secao = "[" ID "]" { atribuicao } ;
    atribuicao = ID "=" valor ";" ;
    valor = NUM | ID | "(" [ valor { "," valor } ] ")" ;
