NAO TERMINAL  ANULAVEL  FIRST / FOLLOW
expr          nao       FIRST  = {NUM, ID, '('}
                        FOLLOW = {$, ')'}
term          nao       FIRST  = {NUM, ID, '('}
                        FOLLOW = {$, '+', '-', ')'}
